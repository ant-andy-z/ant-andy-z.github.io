---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const latestPost = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
posts.sort(
	(a, b) => Number(b.data.pinned) - Number(a.data.pinned) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout title="Yudong Zhang" description="A personal blog for notes, writing, and math.">
	{
		posts.length === 0 ? (
			<p class="empty">No posts yet.</p>
		) : (
			<ul class="post-list">
				{posts.map((post) => (
					<li>
						<article class="post-card">
							<h2>
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>{' '}
								{post.data.pinned && <span class="pinned">PINNED</span>}{' '}
								{post.id === latestPost?.id && <span class="new">NEW!</span>}
							</h2>
							<p class="post-meta">
								<time datetime={post.data.pubDate.toISOString()}>
									{post.data.pubDate.toLocaleDateString('en-US', {
										year: 'numeric',
										month: 'long',
										day: 'numeric',
									})}
								</time>
								{post.data.tags.length > 0 && (
									<> · {post.data.tags.map((tag, index) => <span><a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>{index < post.data.tags.length - 1 && ', '}</span>)}</>
								)}
							</p>
							<p>{post.data.description}</p>
						</article>
					</li>
				))}
			</ul>
		)
	}

	<section class="section-rule" id="collections" aria-labelledby="collections-heading">
		<h2 id="collections-heading">Post Collections</h2>
		<p class="collection-links">
			{tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}
			<a href="/posts/">all posts</a>
		</p>
	</section>

	<section class="section-rule cool-links" id="links" aria-labelledby="links-heading">
		<h2 id="links-heading">Cool Links</h2>
		<p>
			<a href="https://thepolice.com/#/">The Police</a>{' '}
			<a href="https://www.merriam-webster.com/">Merriam-Webster</a>{' '}
			<a href="https://leetcode.com/">LeetCode</a>{' '}
			<a href="https://www.oatly.com/">Oatly</a>{' '}
			<a href="https://www.pret.co.uk/en-GB">Pret</a>
		</p>
	</section>
</BaseLayout>
